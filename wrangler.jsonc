{
  "name": "meteo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",

  "triggers": {
    "crons": [
      "*/10 * * * *",
      "0 * * * *"
    ]
  },

  "kv_namespaces": [
  {
    "binding": "HYDRO",
    "id": "f188888a433e4e3db05039c7d55c3ed4"
  },
  {
    "binding": "RADAR",
    "id": "0727465be0994a628eebbd2a002c428a"
  }
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
